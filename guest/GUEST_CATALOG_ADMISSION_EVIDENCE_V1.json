    "veil-light": {
      "version": "5.3.3",
      "basis": "pre-existing-commercial-seal",
      "source": "guest/GUEST_CATALOG_PIPELINE_V1_FINAL_CERTIFICATION_2026-10-07.md",
      "note": "Previously certified; do not alter or retroactively rewrite this seal to imply new photo-only contract testing."
    },
    "botanica": {
      "version": "14.7",
      "basis": "new-template-gated",
      "gates": {
        "common-questionnaire": {
          "pass": true,
          "source": "guest/GUEST_BOTANICA_ENTRY_51_QUESTIONNAIRE_AND_RSVP_BOUNDARY_2026-10-11.md",
          "why": "Shared Cloudflare questionnaire deployed, two mobile Chromium 7-step flows validated with mocked API (one venue/custom Story, two venues/photo-only), and V17 backend compatible with four actual Cloud orders independently. NOT a real browser-to-Cloud submission test."
        },
        "backend-test-only": {
          "pass": true,
          "source": "guest/GUEST_BOTANICA_ENTRY_46_CLOUD_TESTS_RECOVERED_2026-10-11.md",
          "why": "Supabase Edge V17 ACTIVE source readback plus 4 real authenticated Botánica TEST orders delivered in Cloud; no production sale enabled."
        },
        "renderer": {
          "pass": true,
          "source": "guest/GUEST_BOTANICA_ENTRY_70_V48_ANDROID_RENDERER_ACCEPTED_2026-10-11.md",
          "why": "Physical Android V4.8 video 1000095311.mp4 demonstrates Botánica TEST rendering without adapter_not_found; owner separately confirmed CENTRO GUEST returned to workspace in writing ('Sí. El botón me devolvía'); the return tap was NOT recorded on video. Entry 70. Does not authorize paid publication nor certify experimental generic future-template center."
        },
        "config-matrix": {
          "pass": true,
          "source": "guest/GUEST_D02_BOTANICA_CHECKPOINT_V14_7_2026-10-09.md",
          "why": "Local supported cases and media preservation; NOT E2E."
        },
        "two-real-test-orders": {
          "pass": true,
          "source": "guest/GUEST_BOTANICA_ENTRY_46_CLOUD_TESTS_RECOVERED_2026-10-11.md",
          "why": "4 authenticated Cloud TEST deliveries, two distinct scenarios each repeated, questionnaire/save/submit, synthetic image upload, change/approval, exact Cloudflare URL, server delivery."
        },
        "review-final-parity": {
          "pass": true,
          "source": "guest/GUEST_BOTANICA_ENTRY_62_OWNER_REAL_PARITY_ANDROID_2026-10-11.md",
          "why": "Authenticated live Cloud review_load/public_load for same two delivered Botánica TEST orders (shared + split) compared identical persisted config with signed-media TTL normalization; owner Android screenshot shows both PARITY PASS and real video shows both personalized designs in shared owner QA viewer. Not certification of frozen V4.6 production Center."
        },
        "recipient-rsvp": {
          "pass": true,
          "source": "guest/GUEST_BOTANICA_ENTRY_55_CLOUD_RSVP_OWNER_ANDROID_2026-10-11.md",
          "why": "Real Cloud GUEST TEST Botánica order linked to authorized guests tester license; 2 real guest-source submissions yes/no applied in guest_rsvp_submissions and read-after-write as confirmed/declined for same unit in guest_app_state, plus Android person/unit invitation links shown. Physical CTA click not seen on video; do not claim manual UI RSVP tested."
        },
        "owner-android": {
          "pass": true,
          "source": "guest/GUEST_BOTANICA_ENTRY_50_OWNER_ANDROID_VISUAL_OK_2026-10-11.md",
          "why": "Owner confirmed both final TEST invitations were visually good on physical Android, with video reviews for one-venue custom story and two-venue story-none. RSVP, parity, media quality and owner touch remain separately gated."
        },
        "owner-touch": {
          "pass": true,
          "source": "guest/GUEST_BOTANICA_ENTRY_64_OWNER_TOUCH_REAL_2026-10-11.md",
          "why": "Owner Android screen recording demonstrates five-point review completed and final active time 0:41 (<5min) with TEST send_review confirmation. Independently verified exactly one Botánica synthetic benchmark order in REAL Supabase Cloud status=review_sent. Counts time on loaded visual to sending review, not entire invitation production."
        },
        "media-integrity": {
          "pass": true,
          "source": "guest/GUEST_D02_BOTANICA_CHECKPOINT_V14_7_2026-10-09.md",
          "why": "17 reusable media resources verified against V14 master."
        },
        "approved-visual": {
          "pass": true,
          "source": "guest/GUEST_D02_BOTANICA_READ_FIRST.md",
          "why": "V14 visually approved; V14.7 technical changes require final Android check."
        }
      }
    },
