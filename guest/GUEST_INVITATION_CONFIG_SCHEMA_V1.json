{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weddlysmartdesign.example/schemas/guest-invitation-config-v1.json",
  "title": "GUEST Invitation Config V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "template",
    "couple",
    "wedding",
    "cover",
    "countdown",
    "story",
    "locations",
    "agenda",
    "practical",
    "rsvp",
    "gallery",
    "closing"
  ],
  "properties": {
    "schemaVersion": {
      "const": "guest-invitation-config-v1"
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "typographyVariant"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "typographyVariant": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "locale": {
      "type": "string",
      "default": "es"
    },
    "couple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name1",
        "name2"
      ],
      "properties": {
        "name1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "name2": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        }
      }
    },
    "wedding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "coverPlace"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "time": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 10
        },
        "timezone": {
          "type": "string",
          "default": "Europe/Madrid"
        },
        "coverPlace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36
        }
      }
    },
    "cover": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "photo": {
          "$ref": "#/$defs/photoOrNull"
        }
      }
    },
    "countdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "body",
        "photo"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "heading": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 45
        },
        "body": {
          "type": "string",
          "maxLength": 450
        },
        "photo": {
          "$ref": "#/$defs/photoOrNull"
        }
      }
    },
    "locations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "items",
        "dressCode",
        "saveDate"
      ],
      "properties": {
        "mode": {
          "enum": [
            "shared",
            "split"
          ]
        },
        "heroPhoto": {
          "$ref": "#/$defs/photoOrNull"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "dressCode": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "text": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 60
            }
          }
        },
        "saveDate": {
          "type": "boolean"
        }
      }
    },
    "agenda": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "moments"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "moments": {
          "type": "array",
          "minItems": 0,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "time",
              "label"
            ],
            "properties": {
              "time": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 28
              }
            }
          }
        }
      }
    },
    "practical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bus",
        "accommodation",
        "gift",
        "playlist"
      ],
      "properties": {
        "bus": {
          "$ref": "#/$defs/bus"
        },
        "accommodation": {
          "$ref": "#/$defs/accommodation"
        },
        "gift": {
          "$ref": "#/$defs/gift"
        },
        "playlist": {
          "$ref": "#/$defs/playlist"
        }
      }
    },
    "rsvp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ctaLabel",
        "plusOneEnabled",
        "childrenEnabled",
        "customQuestions"
      ],
      "properties": {
        "ctaLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "default": "Confirmar asistencia"
        },
        "route": {
          "type": [
            "string",
            "null"
          ]
        },
        "plusOneEnabled": {
          "type": "boolean"
        },
        "childrenEnabled": {
          "type": "boolean"
        },
        "customQuestions": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 160
          }
        }
      }
    },
    "gallery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "photos"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "photos": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/photo"
          }
        }
      }
    },
    "closing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "line": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        }
      }
    }
  },
  "$defs": {
    "photo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src",
        "fit",
        "focusX",
        "focusY"
      ],
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "orientation": {
          "enum": [
            "portrait",
            "landscape",
            "square",
            "panorama",
            "unknown"
          ]
        },
        "fit": {
          "enum": [
            "crop",
            "full"
          ]
        },
        "focusX": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "focusY": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "alt": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        }
      }
    },
    "photoOrNull": {
      "anyOf": [
        {
          "$ref": "#/$defs/photo"
        },
        {
          "type": "null"
        }
      ]
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "time",
        "name",
        "address"
      ],
      "properties": {
        "type": {
          "enum": [
            "shared",
            "ceremony",
            "celebration"
          ]
        },
        "time": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 55
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "mapsUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "websiteUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "bus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "pickupPoints",
        "outboundTimes",
        "returnTimes",
        "collectUsageInRSVP",
        "collectRouteChoiceInRSVP",
        "collectReturnChoiceInRSVP"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "pickupPoints": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "maxLength": 60
          }
        },
        "outboundTimes": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "maxLength": 10
          }
        },
        "returnTimes": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "maxLength": 10
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "mapsUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "collectUsageInRSVP": {
          "type": "boolean"
        },
        "collectRouteChoiceInRSVP": {
          "type": "boolean"
        },
        "collectReturnChoiceInRSVP": {
          "type": "boolean"
        }
      }
    },
    "accommodation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "mode",
        "collectAccommodationInRSVP"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "on_site",
            "room_block",
            "couple_managed",
            "recommended",
            "external_booking",
            "none"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 55
        },
        "address": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "websiteUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "mapsUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "phone": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        },
        "bookingCode": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        },
        "bookingName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 60
        },
        "discountText": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        },
        "priceText": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 60
        },
        "externalBookingUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 140
        },
        "collectAccommodationInRSVP": {
          "type": "boolean"
        },
        "collectNightsInRSVP": {
          "type": "boolean",
          "default": false
        },
        "collectOccupancyInRSVP": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "gift": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "mode"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "bank",
            "bizum",
            "external_link",
            "short_text",
            "none"
          ]
        },
        "displayText": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "details": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "externalUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "playlist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "mode"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "external_link",
            "guest_request",
            "none"
          ]
        },
        "prompt": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    }
  }
}
