{
  "cleanUrls": false,
  "redirects": [{ "source": "/", "destination": "/guest/access.html", "permanent": false }],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/guest/guest-sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
